Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox[
      RowBox[{"Q5", ".", "Solve"}], "Subtitle"], 
     StyleBox[" ", "Subtitle"], 
     StyleBox["the", "Subtitle"], 
     StyleBox[" ", "Subtitle"], 
     StyleBox["Cauchy", "Subtitle"], 
     StyleBox[" ", "Subtitle"], 
     StyleBox["problem", "Subtitle"], 
     StyleBox[" ", "Subtitle"], 
     RowBox[{
      StyleBox["(", "Subtitle"], 
      RowBox[{
       StyleBox["1", "Subtitle"], 
       StyleBox["+", "Subtitle"], 
       SuperscriptBox[
        StyleBox["x", "Subtitle"], "2"]}], 
