Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"Q3", ".", "Solve"}], ",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "tt"], "-", 
      RowBox[{"9", 
       SubscriptBox["u", "xx"]}]}], "=", "0"}], ",", 
    RowBox[{
     StyleBox[
      RowBox[{"u", 
       RowBox[{"(", 
        RowBox[{"x", ",", "0"}], ")"}]}],
      FontSize->18], 
     StyleBox["=",
      FontSize->18], 
     RowBox[{
      SuperscriptBox[
       StyleBox["x",
        FontSize->18], "3"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}]}]}], ",", 
    RowBox[{
     StyleBox[
      RowBox[{
       SubscriptBox["u", "t"], 
       RowBox[{"(", 
        RowBox[{"x", ",", "0"}], ")"}]}],
      FontSize->18], 
     StyleBox["=",
      FontSize->18], 
     SuperscriptBox[
      StyleBox["x",
       FontSize->18], "2"]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"u", 
       RowBox[{"(", 
        RowBox[{"0", ",", "t"}], ")"}]}], "=", "0"}], ";", 
     StyleBox[
      RowBox[{"0", "<", "x", "<", "1"}],
      FontSize->18]}], ",", 
    RowBox[{"t", ">", "0"}]}], "\[IndentingNewLine]"}],
  FontSize->18]], "Input",
 CellChangeTimes->{{3.973251434682576*^9, 3.973251534594895*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"8c2c2073-913a-ef40-8c35-48de14d72244"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "-", 
       RowBox[{"9", "*", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], "\[Equal]", "0"}], ",", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
      RowBox[{
       SuperscriptBox["x", "3"], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}], ")"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"0", ",", "1"}], "]"}], "[", "u", "]"}], "[", 
       RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
      SuperscriptBox["x", "2"]}], ",", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{"eqn", ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "4"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<x\>\"", ",", "\"\<u\>\""}], "}"}]}], ",", 
   RowBox[{"Ticks", "\[Rule]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3"}], ",", "0"}], "}"}]}], "}"}]}]}], "]"}]}], "Input",
