Cell[BoxData[
 RowBox[{"The", " ", "Traffic", " ", "Density", " ", "function", " ", 
  "\[Rho]", 
  RowBox[{"(", 
   RowBox[{"x", ",", "t"}], ")"}], " ", "or", " ", "the", " ", "solution", " ",
   "for", " ", "the", " ", "given", " ", "initial", " ", "value", " ", 
  "problem", " ", "are", " ", "given", " ", 
  RowBox[{"by", ":"}]}]], "Input",
 CellChangeTimes->{{3.973253494016016*^9, 
  3.9732535541375437`*^9}},ExpressionUUID->"e74cc092-1ada-c449-8775-\
c59584b213e6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "+", 
     RowBox[{"x", "*", 
      RowBox[{"Sin", "[", "t", "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}]}]}], "\[Equal]", 
    "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol1", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqn1", ",", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"1", " ", "+", " ", 
        FractionBox["1", 
         RowBox[{"1", "+", 
          SuperscriptBox["x", "2"]}]]}]}]}], "}"}], ",", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.973253558971964*^9, 3.9732536963691025`*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"6f667426-9ab1-1047-b34d-9bd2251a5fad"],

