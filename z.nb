Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Q4", ".", "Solve"}], " ", "the", " ", "Cauchy", " ", "problem",
       " ", 
      SubscriptBox[
       StyleBox[
        RowBox[{"y", 
         StyleBox["u", "Subtitle"]}]], "x"]}], " ", "+", 
     SubscriptBox["xu", "y"]}], "=", "0"}], ",", 
   RowBox[{
    RowBox[{"u", 
     RowBox[{"(", 
      RowBox[{"0", ",", "y"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"-", 
       SuperscriptBox[
        StyleBox["y", "Subtitle"], "2"]}], "]"}], "and", " ", "plot", " ", 
     "the", " ", "solution", " ", 
     RowBox[{"also", "."}]}]}]}], "Subtitle"]], "Input",
 CellChangeTimes->{{3.9678630840187063`*^9, 3.967863113802167*^9}, {
  3.9678631563424454`*^9, 
  3.967863159043176*^9}},ExpressionUUID->"149f0b30-7d2f-1b4e-a6cb-\
03a8cf42ed48"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"y", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}], "+", 
     RowBox[{"x", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "\[Equal]", 
    "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"0", ",", "y"}], "]"}], "\[Equal]", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          SuperscriptBox["y", "2"]}], "]"}]}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<solution of given cauchy problem is: \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.967863147145449*^9, 3.9678631964175277`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"dab132ba-f783-844d-ac2e-29729ac0714d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"solution of given cauchy problem is: \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        SuperscriptBox["x", "2"], "-", 
        SuperscriptBox["y", "2"]}]]}], "}"}], "}"}]}],
  SequenceForm[
  "solution of given cauchy problem is: ", {{$CellContext`u[$CellContext`x, \
$CellContext`y] -> E^($CellContext`x^2 - $CellContext`y^2)}}],
  Editable->False]], "Print",
 CellChangeTimes->{3.967863203650813*^9},
 CellLabel->
  "During evaluation of \
In[25]:=",ExpressionUUID->"6e15cd4d-81f8-4a41-90fa-0229ece1c7ac"],

