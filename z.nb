Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["\[ExponentialE]", "2"]}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", 
         RowBox[{"Cos", "[", "t", "]"}]}]], " ", 
       SuperscriptBox["x", "2"]}]}], 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", "2"], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", 
         RowBox[{"Cos", "[", "t", "]"}]}]], " ", 
       SuperscriptBox["x", "2"]}]}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.9732536984810667`*^9},
 CellLabel->"Out[71]=",ExpressionUUID->"9ec0d53c-9907-b64d-8634-dc8cc0d3a657"]
}, Open  ]],

