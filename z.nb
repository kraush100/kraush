Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Q5", ".", "Solve"}], " ", "the", " ", "Cauchy", " ", "problem",
       " ", 
      SubscriptBox["u", "x"]}], " ", "+", 
     RowBox[{"2", 
      SubscriptBox["u", "y"]}]}], "=", "0"}], ",", 
   RowBox[{
    RowBox[{"u", 
     RowBox[{"(", 
      RowBox[{"x", ",", "0"}], ")"}]}], "=", 
    RowBox[{
    "sin", " ", "x", " ", "and", " ", "plot", " ", "the", " ", "solution", " ", 
     RowBox[{"also", "."}]}]}]}], "Subtitle"]], "Input",
 CellChangeTimes->{{3.967863225469921*^9, 3.9678632261513906`*^9}, {
  3.967863484236495*^9, 
  3.967863509690713*^9}},ExpressionUUID->"044a99cb-d49b-cf46-9c12-\
b691739c510d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "+", 
     RowBox[{"2", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "\[Equal]", 
    "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
        RowBox[{"Sin", " ", "[", "x", "]"}]}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<solution of given cauchy problem is: \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9678635393370447`*^9, 3.9678636125601473`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"ab048497-958f-6e4a-a35a-7c55e9783e58"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"solution of given cauchy problem is: \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
      RowBox[{"Sin", "[", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "x"}], "-", "y"}], ")"}]}], "]"}]}], "}"}], 
    "}"}]}],
  SequenceForm[
  "solution of given cauchy problem is: ", {{$CellContext`u[$CellContext`x, \
$CellContext`y] -> Sin[Rational[1, 2] (2 $CellContext`x - $CellContext`y)]}}],
  Editable->False]], "Print",
 CellChangeTimes->{{3.967863573601942*^9, 3.9678636209503813`*^9}},
 CellLabel->
  "During evaluation of \
