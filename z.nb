Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"Q4", ".", "Solve"}], ",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "tt"], "-", 
      RowBox[{"16", 
       SubscriptBox["u", "xx"]}]}], "=", "0"}], ",", 
    RowBox[{
     RowBox[{"u", 
      RowBox[{"(", 
       RowBox[{"x", ",", "0"}], ")"}]}], "=", 
     RowBox[{"x", 
      RowBox[{"(", 
       RowBox[{"1", "-", "x"}], ")"}]}]}], ",", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "t"], 
      RowBox[{"(", 
       RowBox[{"x", ",", "0"}], ")"}]}], "=", "0"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"u", 
       RowBox[{"(", 
        RowBox[{"0", ",", "t"}], ")"}]}], "=", "0"}], ";", 
     RowBox[{"0", "<", "x", "<", "1"}]}], ",", 
    RowBox[{"t", ">", "0"}]}], "\[IndentingNewLine]"}],
  FontSize->18]], "Input",
 CellChangeTimes->{{3.973251692190868*^9, 3.973251733382496*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"39d90524-0b2a-5146-a27f-208234701202"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "-", 
       RowBox[{"16", "*", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], "\[Equal]", "0"}], ",", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
      RowBox[{"x", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "x"}], ")"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"0", ",", "1"}], "]"}], "[", "u", "]"}], "[", 
       RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", "0"}], ",", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{"eqn", ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "4"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<x\>\"", ",", "\"\<u\>\""}], "}"}]}], ",", 
   RowBox[{"Ticks", "\[Rule]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3"}], ",", "0"}], "}"}]}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.973251773395044*^9, 3.973251794163793*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"7c8dbb6e-43d2-244f-8b0f-b434d50a00cf"],

