Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"Q1", ".", " ", "Solve"}], ",", 
   RowBox[{
    SubscriptBox["u", "t"], "=", 
    RowBox[{"0.5", 
     SubscriptBox["u", "xx"]}]}], ",", 
   RowBox[{
    RowBox[{"u", 
     RowBox[{"(", 
      RowBox[{"x", ",", "0"}], ")"}]}], "=", 
    RowBox[{
     SuperscriptBox["Sin", "2"], "x"}]}], ",", 
   RowBox[{
    RowBox[{"u", 
     RowBox[{"(", 
      RowBox[{"0", ",", "t"}], ")"}]}], "=", "0"}], ",", 
   RowBox[{
    RowBox[{"u", 
     RowBox[{"(", 
      RowBox[{"\[Pi]", ",", "t"}], ")"}]}], "=", "0"}], ",", 
   RowBox[{"0", "<", "x", "<", "\[Pi]"}], ",", 
   RowBox[{"t", ">", "0"}]}],
  FontSize->18]], "Input",
 CellChangeTimes->{{3.9732492445283213`*^9, 3.9732494279583673`*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"f3e3a8e0-08ee-674c-8cb8-7d972f73d9cb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{"1", "/", "2"}], "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Sin", "[", "x", "]"}], ")"}], "2"]}], ",", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"0", ",", "t"}], "]"}], "\[Equal]", "0"}], ",", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"\[Pi]", ",", "t"}], "]"}], "\[Equal]", "0"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{"eqn", ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "4"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9732494454382696`*^9, 3.9732494859461823`*^9}, {
