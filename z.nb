Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"Q1", ".", " ", "Plot"}], " ", "the", " ", "characteristic", " ", 
    "curves", " ", "of", " ", "first", " ", "orde", " ", 
    RowBox[{"PDE", ":", " ", 
     RowBox[{
      SubscriptBox["u", "x"], " ", "-", " ", 
      SubscriptBox["u", "y"]}]}]}], "=", "1", " "}],
  FontSize->18]], "Input",
 CellChangeTimes->{{3.9732458128565016`*^9, 3.973245887714184*^9}},
 FontColor->GrayLevel[0],
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"76ca49e0-815e-ce4c-8dc0-a18b254d0def"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "-", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}], "\[Equal]", 
    "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{"pde", ",", 
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.973245895537896*^9, 3.9732459552070155`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"6d5a3a90-d626-3949-8ea4-d9791af4f1dc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
    RowBox[{"x", "+", 
     RowBox[{
      RowBox[{"C", "[", "1", "]"}], "[", 
      RowBox[{"x", "+", "y"}], "]"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.973245956822344*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"48c179d4-9b76-cb45-b81c-5ce3a00fbfe3"]
}, Open  ]],

