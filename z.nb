Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Q1", ".", " ", "Find"}], " ", "the", " ", "traffic", " ", 
     "density", " ", "\[Rho]", 
     RowBox[{"(", 
      RowBox[{"x", ",", "t"}], ")"}], " ", "satisfying", " ", 
     SubscriptBox["\[Rho]", "t"]}], "+", " ", 
    RowBox[{"xSin", 
     RowBox[{"(", "t", ")"}], 
     SubscriptBox["\[Rho]", "x"]}]}], "=", "0"}],
  FontSize->18], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"with", " ", "initial", " ", "condition", " ", 
    SubscriptBox["\[Rho]", "0"], 
    RowBox[{"(", "x", ")"}]}], "=", " ", 
   RowBox[{"1", " ", "+", " ", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"1", "+", 
        SuperscriptBox["x", "2"]}]], ".", "\[IndentingNewLine]", "Plot"}], " ",
      "the", " ", "characteristic", " ", "base", " ", "curves", " ", "and", " ",
      "the", " ", "traffic", " ", "density", " ", 
     RowBox[{"function", ".", " "}]}]}]}],
  FontSize->18]}], "Input",
 CellChangeTimes->{{3.9732526873079147`*^9, 3.973252921390277*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"da21916e-b6a6-144f-ae9e-1bb52318d4db"],

Cell[BoxData[
 RowBox[{"The", " ", "characteristic", " ", "base", " ", "curve", " ", "for", 
  " ", "the", " ", "given", " ", "initial", " ", "value", " ", "problem", " ",
   "are", " ", "given", " ", 
  RowBox[{"by", ":", " "}]}]], "Input",
 CellChangeTimes->{{3.973252943213684*^9, 3.973253036955797*^9}, 
   3.9732534654259033`*^9},ExpressionUUID->"55764eb0-157c-e948-85bb-\
3a4b978b00f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"charBaseCurves1", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], "*", 
        RowBox[{"Sin", "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "\[Equal]", "x0"}]}], "}"}], ",", 
    RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.973252943213684*^9, 3.973253036955797*^9}, 
   3.9732534654259033`*^9},
 CellLabel->"In[67]:=",ExpressionUUID->"e57baf35-6c13-284a-b443-da961ab80f3d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"1", "-", 
       RowBox[{"Cos", "[", "t", "]"}]}]], " ", "x0"}]}], "}"}], 
