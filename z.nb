Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"Q2", ".", " ", "Solve"}], ",", 
   RowBox[{
    SubscriptBox["u", "tt"], "=", 
    SubscriptBox["u", "xx"]}], ",", " ", 
   RowBox[{
    RowBox[{"u", 
     RowBox[{"(", 
      RowBox[{"x", ",", "0"}], ")"}]}], "=", 
    RowBox[{"Sin", "[", "x", "]"}]}], ",", 
   RowBox[{
    RowBox[{
     SubscriptBox["u", "t"], 
     RowBox[{"(", 
      RowBox[{"x", ",", "0"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"Cos", "[", "x", "]"}], ":", " ", 
     RowBox[{"x", " ", "\[Element]", " ", "R"}]}]}], ",", " ", 
   RowBox[{"t", ">", "0"}]}],
  FontSize->18]], "Input",
 CellChangeTimes->{{3.973248636329706*^9, 3.973248664213504*^9}},
 Background->RGBColor[
  0.9, 1, 1],ExpressionUUID->"0f3df545-e1eb-3c4b-895f-f39f0c775f94"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "\[Equal]", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], ",", 
   RowBox[{"u", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "t"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"91b97292-617f-6146-9fb2-e6b774d75ede"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"C", "[", "1", "]"}], "[", 
      RowBox[{"t", "-", "x"}], "]"}], "+", 
     RowBox[{
      RowBox[{"C", "[", "2", "]"}], "[", 
      RowBox[{"t", "+", "x"}], "]"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.973248703071864*^9},
 CellLabel->"Out[35]=",ExpressionUUID->"f52306cf-9775-214a-9d71-ba53b2df18db"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"da", "[", 
   RowBox[{"c_", ",", "f_", ",", "g_", ",", "x_", ",", "t_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "2"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"x", "\[Rule]", " ", 
         RowBox[{"x", "+", 
          RowBox[{"c", "*", "t"}]}]}]}], ")"}], "+", 
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"x", "\[Rule]", " ", 
         RowBox[{"x", "-", 
          RowBox[{"c", "*", "t"}]}]}]}], ")"}]}], ")"}]}], "+", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "c"}], ")"}]}], "*", 
    RowBox[{"Integrate", "[", 
     RowBox[{"g", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"x", "-", 
         RowBox[{"c", "*", "t"}]}], ",", 
        RowBox[{"x", "+", 
         RowBox[{"c", "*", "t"}]}]}], "}"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"da", "[", 
  RowBox[{"1", ",", 
   RowBox[{"Sin", "[", "x", "]"}], ",", 
   RowBox[{"Cos", "[", "x", "]"}], ",", "x", ",", "t"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "1", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", "x", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.973248740230484*^9, 3.9732487506892495`*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"508cffd3-1235-9542-b8bb-78e9326ba650"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Cos", "[", "x", "]"}], " ", 
   RowBox[{"Sin", "[", "t", "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", 
       RowBox[{"t", "-", "x"}], "]"}]}], "+", 
     RowBox[{"Sin", "[", 
      RowBox[{"t", "+", "x"}], "]"}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.973248758065197*^9},
 CellLabel->"Out[37]=",ExpressionUUID->"6aad6282-7e1e-7b42-bc73-979d1d7f1e68"],

