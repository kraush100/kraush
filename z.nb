       RowBox[{"x", ",", "t"}], "}"}]}], "]"}]}], ";"}],
  FontSize->16], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{"Print", "[", 
   RowBox[{"\"\<General Solution of given Partial Differential Equation is : \
\>\"", ",", "sol"}], "]"}],
  FontSize->16]}], "Input",
 CellChangeTimes->{{3.9656325745843143`*^9, 3.9656325825587177`*^9}},
 FontSize->14,
 FontWeight->"Plain",
 CellLabel->"In[16]:=",ExpressionUUID->"4b36ef15-ee67-4307-a0b5-2e1426ed1ce8"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"General Solution of given Partial Differential Equation is : \
\"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
      RowBox[{
       RowBox[{
        RowBox[{"C", "[", "1", "]"}], "[", 
        RowBox[{"t", "-", 
         FractionBox["x", "2"]}], "]"}], "+", 
       RowBox[{
        RowBox[{"C", "[", "2", "]"}], "[", 
        RowBox[{"t", "+", 
         FractionBox["x", "2"]}], "]"}]}]}], "}"}], "}"}]}],
  SequenceForm[
  "General Solution of given Partial Differential Equation is : ", \
{{$CellContext`u[$CellContext`x, $CellContext`t] -> 
     C[1][$CellContext`t + Rational[-1, 2] $CellContext`x] + 
      C[2][$CellContext`t + Rational[1, 2] $CellContext`x]}}],
  Editable->False]], "Print",
 CellChangeTimes->{3.9656325850854163`*^9},
 FontSize->14,
 CellLabel->
  "During evaluation of \
In[16]:=",ExpressionUUID->"72a6563c-f763-4864-8740-f3609950412e"]
}, Open  ]],

Cell[BoxData["Quit"], "Input",
 CellChangeTimes->{{4.0041536694224377`*^9, 4.0041536707067776`*^9}, {
  4.0041537011556892`*^9, 4.0041537011556892`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"2b0216f8-c28e-4940-b25c-89183e628f10"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["question 2",
 FontFamily->"Stencil",
 FontSize->48,
 FontWeight->"Bold",
 FontColor->RGBColor[0.5019607843137255, 0., 0.]]], "Section",
 CellChangeTimes->{{3.967861085805518*^9, 3.96786112387139*^9}, {
   3.973244374116724*^9, 3.9732444152385035`*^9}, {3.973244458544059*^9, 
   3.973244479199829*^9}, 3.973244514627099*^9, {4.0041543504693336`*^9, 
   4.0041543783897705`*^9}},
 TextAlignment->Center,ExpressionUUID->"607ff4d5-32b2-804a-b4cb-16cc92d3b4cc"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Q1", ".", "Solve"}], " ", "the", " ", "Cauchy", " ", "problem",
       " ", 
      SubscriptBox[
       StyleBox["u", "Subtitle"], "x"]}], " ", "+", 
     SubscriptBox["xu", "y"]}], "=", "y"}], ",", 
   RowBox[{
    RowBox[{"u", 
     RowBox[{"(", 
      RowBox[{"0", ",", "y"}], ")"}]}], "=", 
    RowBox[{
     SuperscriptBox["y", 
      RowBox[{"2", "  "}]], "and", " ", "plot", " ", "the", " ", "solution", " ", 
     RowBox[{"also", "."}]}]}]}], "Subtitle"]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9678611365810266`*^9, 3.967861152031952*^9}, {
  3.967861314434347*^9, 3.9678613372639675`*^9}, {3.967861378075506*^9, 
  3.9678616865449457`*^9}, {3.967862027470961*^9, 3.9678620284058065`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"3329fe3f-634c-5f4c-b05c-4c3cd3ae1d87"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "+", 
     RowBox[{"x", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "\[Equal]", 
    "y"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"0", ",", "y"}], "]"}], "\[Equal]", 
        SuperscriptBox["y", "2"]}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<solution of given cauchy problem is: \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.967861692379114*^9, 3.967861925616081*^9}, {
  3.967861984224532*^9, 3.967861993651577*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"df0d8c50-d2c0-1a4a-9c41-8ff5ba26328b"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"solution of given cauchy problem is: \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
      RowBox[{
       FractionBox["1", "12"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], " ", 
          SuperscriptBox["x", "3"]}], "+", 
         RowBox[{"3", " ", 
          SuperscriptBox["x", "4"]}], "+", 
         RowBox[{"12", " ", "x", " ", "y"}], "-", 
         RowBox[{"12", " ", 
          SuperscriptBox["x", "2"], " ", "y"}], "+", 
         RowBox[{"12", " ", 
          SuperscriptBox["y", "2"]}]}], ")"}]}]}], "}"}], "}"}]}],
  SequenceForm[
  "solution of given cauchy problem is: ", {{$CellContext`u[$CellContext`x, \
$CellContext`y] -> 
     Rational[1, 12] ((-4) $CellContext`x^3 + 
       3 $CellContext`x^4 + (12 $CellContext`x) $CellContext`y - (
        12 $CellContext`x^2) $CellContext`y + 12 $CellContext`y^2)}}],
  Editable->False]], "Print",
 CellChangeTimes->{3.9678619278604393`*^9, 3.9678619978731585`*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"c56be0ad-f4e7-494e-867c-917e49c743f1"]
}, Open  ]],

