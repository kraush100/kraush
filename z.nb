Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "+", 
     RowBox[{
      RowBox[{"Exp", "[", "t", "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}]}]}], "\[Equal]", 
    RowBox[{"2", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol2", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqn2", ",", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{
         RowBox[{"Sin", "[", "x", "]"}], "*", 
         RowBox[{"Sin", "[", "x", "]"}]}]}]}]}], "}"}], ",", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t"}], "}"}]}], "]"}]}]}], "Input",
