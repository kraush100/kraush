Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Q2", ".", "Solve"}], " ", "the", " ", "Cauchy", " ", "problem",
       " ", 
      SubscriptBox[
       StyleBox["u", "Subtitle"], "x"]}], " ", "+", 
     SubscriptBox["u", "y"]}], "=", "1"}], "Subtitle"], 
  StyleBox[",", "Subtitle"], 
  RowBox[{
   StyleBox[
    RowBox[{"u", 
     RowBox[{"(", 
      RowBox[{"x", ",", "0"}], ")"}]}], "Subtitle"], "=", 
   StyleBox[
    RowBox[{
     SuperscriptBox["x", 
      RowBox[{"2", "  "}]], "and", " ", "plot", " ", "the", " ", "solution", " ", 
     RowBox[{"also", "."}]}], "Subtitle"]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9678620155108156`*^9, 3.967862022023823*^9}, {
  3.967862464698799*^9, 3.9678624807449436`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"78bc8b6e-941f-3f4f-bda9-7966428a9124"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "+", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}], "\[Equal]", 
    "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
        SuperscriptBox["x", "2"]}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<solution of given cauchy problem is: \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.967862505673298*^9, 3.967862565725809*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"a095fb4a-3656-2549-af17-226fa68502eb"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"solution of given cauchy problem is: \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
