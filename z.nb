Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"Q3", ".", 
    RowBox[{
     RowBox[{
      RowBox[{"Solve", " ", "the", " ", "Cauchy", " ", "problem", " ", 
       SubscriptBox[
        StyleBox["u", "Subtitle"], "x"]}], " ", "+", 
      SubscriptBox["xu", "y"]}], "=", "0"}]}], ",", 
   RowBox[{
    RowBox[{"u", 
     RowBox[{"(", 
      RowBox[{"0", ",", "y"}], ")"}]}], "=", 
    RowBox[{"siny", " ", "and", " ", "plot", " ", "the", " ", "solution", " ", 
     RowBox[{"also", "."}]}]}]}], "Subtitle"]], "Input",
 CellChangeTimes->{{3.967862616125615*^9, 
  3.9678626466840324`*^9}},ExpressionUUID->"95ace591-36f8-5245-8590-\
19383e4ef466"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "+", 
     RowBox[{"x", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "\[Equal]", 
    "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"0", ",", "y"}], "]"}], "\[Equal]", 
        RowBox[{"Sin", " ", "[", "y", "]"}]}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<solution of given cauchy problem is: \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9678626738009624`*^9, 3.9678627012373323`*^9}, {
  3.96786293486382*^9, 3.967862953382832*^9}, {3.967862985656315*^9, 
  3.967862995230507*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"9b53a405-1d00-a24b-b52a-2356086b5b6a"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"solution of given cauchy problem is: \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
      RowBox[{"Sin", "[", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["x", "2"]}], "+", 
          RowBox[{"2", " ", "y"}]}], ")"}]}], "]"}]}], "}"}], "}"}]}],
  SequenceForm[
  "solution of given cauchy problem is: ", {{$CellContext`u[$CellContext`x, \
$CellContext`y] -> 
     Sin[Rational[1, 2] (-$CellContext`x^2 + 2 $CellContext`y)]}}],
  Editable->False]], "Print",
 CellChangeTimes->{3.967862708590661*^9, 3.967862947865106*^9, 
  3.967863019252119*^9},
 CellLabel->
  "During evaluation of \
